---
import '../styles/global.css';
import DepthGauge from '../components/DepthGauge.astro';
import { LINKS, SITE } from '../site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** depth reached at the bottom of the page when it has no depth sections */
  gaugeMax?: number;
  /** extra class on <html>, e.g. to override the type pairing */
  htmlClass?: string;
}

const { title, description = SITE.description, noindex = false, gaugeMax, htmlClass } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// social share card, rendered by scripts/make-og.py
const ogImage = new URL(url('/og.png'), Astro.site).href;
const ogImageAlt = `${SITE.name}, ${SITE.role}: I build the boring parts of shipping software, so teams can spend their time on the fun ones.`;
// lets search engines tie this site to the same person's other profiles
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: 'Bemesko',
  jobTitle: SITE.role,
  url: new URL(url('/'), Astro.site).href,
  image: ogImage,
  sameAs: [LINKS.linkedin, LINKS.github, LINKS.blog],
};
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

const nav = [
  { href: url('/about/'), label: './about', current: path.startsWith('/about') },
  { href: url('/toolbox/'), label: './toolbox', current: path.startsWith('/toolbox') },
  { href: LINKS.blog, label: './blog ↗', current: false },
  { href: url('/#contact'), label: './contact', current: false },
];
---

<!doctype html>
<html lang="en" class:list={[htmlClass ?? SITE.typePairing]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#14233A" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <DepthGauge max={gaugeMax} />
    <div class="page" id="top">
      <header class="site-header">
        <a class="logo" href={url('/')} aria-label={`${SITE.name}, home`}>
          ~/<span>captain-devops</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={n.current ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="site-footer">
        <span>
          {SITE.brand} · {SITE.name} · {new Date().getFullYear()}
        </span>
        <a href="#top">back to the surface ↑</a>
        <p class="credits">
          Chart engravings by Delapouite from <a href="https://game-icons.net/">game-icons.net</a>,
          under <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>, recoloured.
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    margin-left: var(--gauge-w);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    /* exact height on desktop: the home hero sizes itself against it */
    min-height: var(--header-h);
    padding: 12px max(var(--gutter), calc((100% - var(--content-max)) / 2));
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .site-header :focus-visible,
  .site-footer :focus-visible {
    outline-color: var(--on-ink-accent);
  }
  .logo {
    text-decoration: none;
    font-weight: 500;
  }
  .logo:hover {
    color: var(--on-ink);
  }
  .logo span {
    color: var(--on-ink-accent);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
    list-style: none;
  }
  nav a {
    text-decoration: none;
    color: var(--on-ink-muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--on-ink-accent);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
  }
  .site-footer {
    padding: 32px max(var(--gutter), calc((100% - var(--content-max)) / 2));
    background: var(--ink);
    color: var(--on-ink);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--on-ink-accent);
  }
  .credits {
    flex-basis: 100%;
    font-size: 0.68rem;
    color: var(--on-ink-muted);
  }
  .credits a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 860px) {
    .page {
      margin-left: 0;
    }
    nav ul {
      gap: 14px;
    }
  }
  @media (max-width: 420px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
