---
/**
 * Small tool engravings hidden on the chart, outlined in the contour colour
 * like the rest of the chart. They sit in their own layer above the zone
 * content so hovering works, so place them in empty space. Hovering inks one
 * up and shows the tool's name, linked to its official docs.
 * Decorative and mouse-only: hidden from assistive tech, out of the tab
 * order, and hidden on narrow screens.
 */
import { FIGURES, type Sighting } from '../data/sightings';

interface Props {
  sightings: Sighting[];
}
const { sightings } = Astro.props;
---

<div class="sightings" aria-hidden="true">
  {sightings.map((s) => (
    <span
      class="sighting"
      style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;--rot:${s.rotate ?? 0}deg`}
    >
      <svg viewBox="0 0 512 512">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
          set:html={FIGURES[s.fig].body}
        />
      </svg>
      <span class="tag">
        {FIGURES[s.fig].tools.map((t, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={t.docs} tabindex="-1" target="_blank" rel="noopener">
              {t.name} <span class="arrow">↗</span>
            </a>
          </>
        ))}
      </span>
    </span>
  ))}
</div>

<style>
  .sightings {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* outlined like the contours; they ink up when found */
  .sighting {
    position: absolute;
    display: block;
    color: var(--contour);
    transform: rotate(var(--rot));
    pointer-events: auto;
    transition: color 0.25s;
  }
  .sighting svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* the stroke width is set in screen pixels, whatever the figure's size */
  .sighting svg :global(path) {
    vector-effect: non-scaling-stroke;
  }
  .sighting:hover {
    color: var(--accent);
  }
  /* padding bridges the gap to the figure so the pointer can reach the links */
  .tag {
    position: absolute;
    left: 50%;
    top: 100%;
    padding-top: 6px;
    transform: translateX(-50%) rotate(calc(-1 * var(--rot)));
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-ink);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0.25s;
  }
  .sighting:hover .tag {
    opacity: 1;
    visibility: visible;
  }
  .tag a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .tag a:hover {
    color: var(--accent);
  }
  .arrow {
    font-size: 0.65rem;
  }
  .sep {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .sighting,
    .tag {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .sightings {
      display: none;
    }
  }
</style>
