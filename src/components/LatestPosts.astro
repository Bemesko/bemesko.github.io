---
/**
 * Latest posts from Captain DevOps' Notes, read from src/data/posts.json.
 * That file is refreshed at build time by scripts/fetch-posts.mjs.
 */
import posts from '../data/posts.json';

interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
const latest = posts.slice(0, limit);
const fmt = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' });
---

{latest.length > 0 && (
  <ol class="posts">
    {latest.map((p) => (
      <li>
        <p class="meta mono">
          <time datetime={p.date}>{fmt.format(new Date(p.date))}</time>
          <span aria-hidden="true">·</span>
          <span>{p.minutes} min read</span>
        </p>
        <a href={p.url} target="_blank" rel="noopener" class="title">
          {p.title} <span aria-hidden="true">↗</span>
        </a>
        <p class="excerpt">
          {p.subtitle && <em>{p.subtitle.replace(/\.?$/, '.')} </em>}
          {p.excerpt}
        </p>
      </li>
    ))}
  </ol>
)}

<style>
  .posts {
    list-style: none;
    border-top: var(--hairline);
  }
  .posts li {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: var(--hairline);
  }
  .meta {
    display: flex;
    gap: 8px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.08rem;
    text-decoration: none;
  }
  .title span {
    font-size: 0.8em;
    color: var(--accent-ink);
  }
  .title:hover {
    color: var(--accent-ink);
  }
  .excerpt {
    font-size: 0.92rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .excerpt em {
    color: var(--ink);
  }
</style>
