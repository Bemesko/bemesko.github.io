---
/** A small "file" card rendering a flat YAML document with syntax colours. */
type Value = string | number | boolean | string[];
interface Entry {
  key: string;
  value: Value;
  comment?: string;
}
interface Props {
  filename: string;
  root: string;
  entries: Entry[];
}
const { filename, root, entries } = Astro.props;
---

<div class="yaml-card">
  <span class="file">{filename}</span>
  <pre class="yaml"><span class="line root"><span class="k">{root}</span>:</span>{entries.map((e) => (<span class="line"><span class="k">{e.key}</span>: {Array.isArray(e.value) ? (<>[{e.value.map((v, i) => <>{i > 0 && ', '}<span class="v">{v}</span></>)}]</>) : (<span class="v">{String(e.value)}</span>)}{e.comment && <span class="c">  # {e.comment}</span>}</span>))}</pre>
</div>

<style>
  /* the label sits on the border, so the card itself must not clip */
  .yaml-card {
    position: relative;
    margin-top: 0.75em;
    background: var(--paper);
    border: var(--hairline);
  }
  .file {
    position: absolute;
    top: 0;
    left: 14px;
    transform: translateY(-50%);
    background: var(--paper);
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .yaml {
    padding: 22px 22px 18px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.9;
    /* long lines wrap with a hanging indent instead of scrolling */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .line {
    display: block;
    padding-left: 4ch;
    text-indent: -2ch;
  }
  .line.root {
    padding-left: 0;
    text-indent: 0;
  }
  .k {
    color: var(--ink);
    font-weight: 500;
  }
  .v {
    color: var(--accent);
  }
  .c {
    color: var(--muted);
  }
</style>
