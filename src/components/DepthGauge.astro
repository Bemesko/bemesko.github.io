---
/**
 * Fixed depth gauge on a linear scale. The label step follows the page's own
 * section depths (their greatest common divisor), so a page in steps of 10 m
 * is labelled every 10 m and one in steps of 15 m every 15 m, with minor
 * ticks every 5 m in between. Scroll position maps to depth through the
 * [data-depth] sections, so reaching a section shows that section's depth.
 * Pages without depth sections map scroll progress linearly to `max`.
 * On narrow screens it collapses into a thin progress bar at the top.
 */
interface Props {
  /** depth reached at the bottom of pages without [data-depth] sections */
  max?: number;
}
const { max = 45 } = Astro.props;
---

<div class="gauge" data-max={max} aria-hidden="true">
  <span class="label">DEPTH</span>
  <div class="scale">
    <div class="ticks"></div>
    <div class="fill"></div>
  </div>
  <span class="val">0 m</span>
</div>

<script>
  const DEFAULT_STEP = 15;
  const MAX_LABELS = 8;
  const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));

  /** Label step shared by every section depth, widened if it would crowd the scale. */
  function labelStep(depths: number[]) {
    const nonzero = depths.filter((d) => d > 0);
    let step = nonzero.length ? nonzero.reduce(gcd) : DEFAULT_STEP;
    const deepest = Math.max(step, ...nonzero);
    while (Math.ceil(deepest / step) > MAX_LABELS) step *= 2;
    return step;
  }

  /** Minor ticks every 5 m when that divides the step evenly, else none. */
  const tickStep = (step: number) => (step % 5 === 0 && step / 5 <= 6 ? 5 : step);

  function initGauge() {
    const gauge = document.querySelector<HTMLElement>('.gauge');
    if (!gauge) return;
    const ticksEl = gauge.querySelector<HTMLElement>('.ticks')!;
    const val = gauge.querySelector<HTMLElement>('.val')!;
    const fallbackMax = Number(gauge.dataset.max) || 45;
    let stops: { depth: number; frac: number }[] = [];
    let labels: { depth: number; el: HTMLElement }[] = [];
    let scaleMax = 0;
    let step = DEFAULT_STEP;

    const maxScroll = () => Math.max(1, document.documentElement.scrollHeight - window.innerHeight);

    /* Ticks depend only on the page's depths, not on scroll. */
    function drawScale() {
      ticksEl.replaceChildren();
      labels = [];
      const minor = tickStep(step);
      for (let d = 0; d <= scaleMax; d += minor) {
        const major = d % step === 0;
        const tick = document.createElement('span');
        tick.className = major ? 'tick major' : 'tick';
        tick.style.top = `${(d / scaleMax) * 100}%`;
        ticksEl.append(tick);
        if (major) {
          const label = document.createElement('span');
          label.className = 'num';
          label.textContent = String(d);
          label.style.top = tick.style.top;
          ticksEl.append(label);
          labels.push({ depth: d, el: label });
        }
      }
    }

    function layout() {
      const sections = [...document.querySelectorAll<HTMLElement>('[data-depth]')];
      const total = maxScroll();
      stops = sections.map((s) => {
        const top = s.getBoundingClientRect().top + window.scrollY;
        return {
          depth: Number(s.dataset.depth),
          frac: Math.min(1, Math.max(0, top / total)),
        };
      });
      const depths = stops.map((s) => s.depth);
      const nextStep = labelStep(depths);
      const deepest = depths.length ? Math.max(...depths) : fallbackMax;
      const nextMax = Math.max(nextStep, Math.ceil(deepest / nextStep) * nextStep);
      if (nextMax !== scaleMax || nextStep !== step) {
        scaleMax = nextMax;
        step = nextStep;
        drawScale();
      }
      update();
    }

    function depthAt(p: number) {
      if (stops.length === 0) return p * fallbackMax;
      if (p <= stops[0].frac) return stops[0].depth;
      for (let i = 0; i < stops.length - 1; i++) {
        const a = stops[i];
        const b = stops[i + 1];
        if (p <= b.frac) {
          const t = b.frac === a.frac ? 1 : (p - a.frac) / (b.frac - a.frac);
          return a.depth + (b.depth - a.depth) * t;
        }
      }
      return stops[stops.length - 1].depth;
    }

    function update() {
      const p = Math.min(1, Math.max(0, window.scrollY / maxScroll()));
      const depth = depthAt(p);
      gauge!.style.setProperty('--p', String(depth / scaleMax));
      // the mobile bar shows plain scroll progress
      gauge!.style.setProperty('--scroll', String(p));
      val.textContent = `${Math.round(depth)} m`;
      for (const l of labels) l.el.classList.toggle('on', depth >= l.depth - 0.5);
    }

    let raf = 0;
    const schedule = (fn: () => void) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(fn);
    };
    window.addEventListener('scroll', () => schedule(update), { passive: true });
    window.addEventListener('resize', () => schedule(layout));
    document.fonts?.ready.then(layout);
    layout();
  }
  initGauge();
</script>

<style>
  .gauge {
    --p: 0;
    --scroll: 0;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--gauge-w);
    background: var(--ink);
    color: var(--on-ink);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--on-ink-muted);
  }
  .scale {
    flex: 1;
    width: 100%;
    position: relative;
    /* room so the first and last labels aren't clipped */
    margin: 22px 0 10px;
  }
  .ticks {
    position: absolute;
    inset: 0;
  }
  .ticks :global(.tick) {
    position: absolute;
    right: 0;
    width: 8px;
    height: 1px;
    background: var(--on-ink-muted);
    opacity: 0.6;
  }
  .ticks :global(.tick.major) {
    width: 18px;
    opacity: 1;
  }
  .ticks :global(.num) {
    position: absolute;
    left: 10px;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--on-ink-muted);
  }
  .ticks :global(.num.on) {
    color: var(--on-ink-accent);
  }
  .fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: calc(var(--p) * 100%);
    background: var(--on-ink-accent);
  }
  .val {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--on-ink);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    /* fixed length so "5 m" and "60 m" don't resize the scale above */
    flex: none;
    height: 6ch;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .gauge {
      right: 0;
      bottom: auto;
      width: auto;
      height: 3px;
      padding: 0;
      background: transparent;
    }
    .label,
    .val,
    .ticks {
      display: none;
    }
    .scale {
      margin: 0;
      height: 3px;
    }
    .fill {
      height: 3px;
      width: calc(var(--scroll) * 100%);
      background: var(--accent);
    }
  }
</style>
