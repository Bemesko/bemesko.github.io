---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthZone from '../components/DepthZone.astro';
import { LEVELS, toolbox, type Level, type Tool } from '../data/toolbox';
import type { Sighting } from '../data/sightings';

// a fixed 10 m per stage keeps the depth gauge on round numbers
const DEPTH_STEP = 10;
// spread the stages evenly over bands 1 to 3, shallow to deep
const bandFor = (i: number) => (1 + Math.floor((i * 3) / toolbox.length)) as 1 | 2 | 3;
const levelOrder: Level[] = ['preferred', 'regular', 'used'];
// tool engravings tucked into the top margin of a few stages
const sightingsFor: Record<string, Sighting[]> = {
  ship: [{ fig: 'crate', x: 88, y: 2, size: 56, rotate: 4 }],
};
// project-only tools sit in a collapsed list under each stage
const mainTools = (tools: Tool[]) => tools.filter((t) => t.level !== 'used');
const projectTools = (tools: Tool[]) => tools.filter((t) => t.level === 'used');
---

<BaseLayout
  title="Toolbox"
  description="The tools Bernardo Mesko works with, from daily drivers to project-specific picks."
>
  <DepthZone id="toolbox" depth={0} band={0}>
    <div class="head">
      <div>
        <p class="mono">Toolbox</p>
        <h1>What's on board.</h1>
        <p class="lead">
          Everything I know well enough to start working with right away, grouped by where it fits
          in delivery: code, provision, ship, run, store, observe, secure, docs. The filled marks
          are my default picks; tools I've only used on specific projects are folded under each
          stage.
        </p>
      </div>
      <aside class="legend" aria-label="Legend">
        <p class="legend-title">Legend</p>
        <ul>
          {levelOrder.map((l) => (
            <li>
              <span class:list={['mark', l]} aria-hidden="true">
                {LEVELS[l].mark}
              </span>
              {LEVELS[l].label}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </DepthZone>

  {toolbox.map((g, i) => (
    <DepthZone
      id={g.id}
      depth={(i + 1) * DEPTH_STEP}
      band={bandFor(i)}
      title={g.title}
      contours={i % 2 === 0 ? 'shoal' : 'slope'}
      sightings={sightingsFor[g.id]}
    >
      <p class="blurb">{g.blurb}</p>
      {mainTools(g.tools).length > 0 && (
        <ul class="tools">
          {mainTools(g.tools).map((t) => (
            <li class={t.level}>
              <span class:list={['mark', t.level]} aria-hidden="true">
                {LEVELS[t.level].mark}
              </span>
              <span class="name">{t.name}</span>
              <span class="visually-hidden">({LEVELS[t.level].label})</span>
              {t.note && <span class="note mono">{t.note}</span>}
            </li>
          ))}
        </ul>
      )}
      {projectTools(g.tools).length > 0 && (
        <details class="more">
          <summary class="mono">
            <span class="count">{projectTools(g.tools).length}</span> more {LEVELS.used.label}
          </summary>
          <ul class="tools">
            {projectTools(g.tools).map((t) => (
              <li class={t.level}>
                <span class:list={['mark', t.level]} aria-hidden="true">
                  {LEVELS[t.level].mark}
                </span>
                <span class="name">{t.name}</span>
                <span class="visually-hidden">({LEVELS[t.level].label})</span>
                {t.note && <span class="note mono">{t.note}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}
    </DepthZone>
  ))}
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: end;
    padding: 24px 0;
  }
  h1 {
    margin: 14px 0 18px;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }
  .lead {
    max-width: 48ch;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
  .legend {
    border: 1px solid var(--ink);
    outline: 0.5px solid var(--ink);
    outline-offset: 4px;
    margin: 6px;
    padding: 16px 20px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    max-width: 260px;
  }
  .legend-title {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .legend ul {
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .legend li {
    display: flex;
    gap: 8px;
  }
  .blurb {
    color: var(--ink-soft);
    margin: -12px 0 24px;
  }
  .tools {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    border-top: var(--hairline);
    border-left: var(--hairline);
  }
  /* mark in its own column, so long names wrap beside it instead of under it */
  .tools li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    align-items: baseline;
    align-content: start;
    gap: 4px 10px;
    padding: 14px 16px;
    border-right: var(--hairline);
    border-bottom: var(--hairline);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }
  .more {
    margin-top: 14px;
  }
  .tools + .more {
    margin-top: 18px;
  }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    font-size: 0.78rem;
    color: var(--accent-ink);
    padding: 6px 0;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::before {
    content: '+';
    display: inline-block;
    width: 1ch;
    font-weight: 700;
  }
  .more[open] summary::before {
    content: '−';
  }
  .more summary:hover {
    text-decoration: underline;
  }
  .more .tools {
    margin-top: 10px;
  }
  .tools li.preferred {
    background: var(--paper);
  }
  .tools li.used {
    background: transparent;
  }
  .tools li.used .name {
    color: var(--ink-soft);
  }
  .mark {
    display: inline-block;
    width: 12px;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .mark.preferred {
    color: var(--accent);
  }
  .mark.used {
    font-weight: 700;
  }
  .name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.05rem;
  }
  .preferred .name {
    font-weight: 600;
  }
  .note {
    grid-column: 2;
    font-size: 0.7rem;
  }
  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
