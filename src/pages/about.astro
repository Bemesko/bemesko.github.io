---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthZone from '../components/DepthZone.astro';
import YamlCard from '../components/YamlCard.astro';
import Portrait from '../components/Portrait.astro';
import { CONTACT, LINKS, SITE } from '../site';
import { BLOG_SINCE, certs, timeline } from '../data/career';

const education = [
  {
    when: '2021 – 2024',
    what: 'B.Tech. in Systems Development & Analysis, Estácio de Sá University',
  },
  {
    when: '2018 – 2021',
    what: 'Technical degree in Informatics, Federal Institute of Santa Catarina (IFSC)',
  },
];

const talks = [
  {
    when: '2026',
    what: 'Agentic DevOps',
    where: 'Webinar co-hosted with Microsoft',
    note: 'Live demo of a multi-agent squad shipping through GitHub Actions, Bicep and Azure Container Apps.',
  },
  {
    when: '2025',
    what: 'Observability on Kubernetes with OpenTelemetry',
    where: 'Codecon Meetup',
  },
];
---

<BaseLayout title="About" description={`About ${SITE.name}, Platform Engineer from Brazil.`}>
  <DepthZone id="about" depth={0} band={0}>
    <div class="intro">
      <div>
        <p class="mono">About</p>
        <h1>Hi, I'm Bernardo.</h1>
        <div class="prose">
          <p>
            I'm a platform engineer from Brazil. Over the last five years I've worked in healthcare,
            in software that runs steel plants, and in two consultancies, with teams in Germany,
            India and Poland along the way.
          </p>
          <p>
            What I like most is building the paved road: golden paths, GitOps and observability that
            let product teams ship without thinking about the plumbing. Lately that road leads to AI
            agents, and to the unglamorous parts that make them safe to run: least privilege,
            budgets and telemetry.
          </p>
          <p>
            I also care about the people on the road. Some of my favourite work was bringing
            engineering practices to teams that never had them, from low-code developers to data
            scientists.
          </p>
        </div>
      </div>
      <div class="side">
        <Portrait
          sizes="(max-width: 860px) 90vw, (max-width: 1200px) 280px, 480px"
          loading="eager"
          caption="fig. 1 · at the helm"
        />
        <YamlCard
          filename="captain.yaml"
          root="captain"
          entries={[
            { key: 'name', value: SITE.name },
            { key: 'role', value: 'platform engineer' },
            { key: 'based', value: 'brazil (utc-3) · remote' },
            { key: 'clouds', value: ['azure', 'aws'] },
            { key: 'stack', value: ['kubernetes', 'terraform', 'argocd', 'opentelemetry'] },
            { key: 'certs', value: '8x microsoft certified' },
            { key: 'writes', value: `captain devops' notes (${BLOG_SINCE} – ongoing)` },
            { key: 'off_the_cluster', value: ['speedcubing', 'homelab'] },
          ]}
        />
      </div>
    </div>
  </DepthZone>

  <DepthZone id="path" depth={15} band={1} title="Path so far" contours="shoal">
    <ol class="timeline">
      {timeline.map((t) => (
        <li>
          <span class="mono when">{t.when}</span>
          <div>
            <h3>{t.where}</h3>
            <p>{t.what}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="two-col">
      <div>
        <h3 class="sub">Education</h3>
        <ul class="plain">
          {education.map((e) => (
            <li>
              <span class="mono when">{e.when}</span> {e.what}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="sub">Certifications</h3>
        <ul class="plain certs">
          {certs.map((c) => (
            <li>Microsoft Certified: {c}</li>
          ))}
        </ul>
      </div>
    </div>
  </DepthZone>

  <DepthZone
    id="talks"
    depth={30}
    band={2}
    title="Talks & writing"
    contours="slope"
    sightings={[{ fig: 'lighthouse', x: 82, y: 12, size: 64, rotate: -3 }]}
  >
    <ul class="talks">
      {talks.map((t) => (
        <li>
          <span class="mono when">{t.when}</span>
          <div>
            <h3>{t.what}</h3>
            <p class="mono">{t.where}</p>
            {t.note && <p>{t.note}</p>}
          </div>
        </li>
      ))}
      <li>
        <span class="mono when">{BLOG_SINCE} – ongoing</span>
        <div>
          <h3>
            <a href={LINKS.blog}>Captain DevOps' Notes ↗</a>
          </h3>
          <p class="mono">Blog</p>
          <p>Where I write about what I'm learning on the job, so it outlives the project.</p>
        </div>
      </li>
    </ul>
  </DepthZone>

  <DepthZone
    id="off-the-cluster"
    depth={45}
    band={2}
    title="Off the cluster"
    contours="basin"
    sightings={[{ fig: 'mermaid', x: 82, y: 16, size: 72, rotate: 4 }]}
  >
    <div class="prose">
      <p>
        I once got first place at a national <a href={LINKS.wca}>speedcubing</a> competition.
        Doesn't matter if it was only first place in the rookies category, I still got a medal
        afterwards.
      </p>
      <p>
        I also spent a few months as one of two Unity programmers on EcoTour GL, an award-winning
        mobile visual novel, and automated its weekly builds with GitHub Actions.
      </p>
      <p>
        At home, an old laptop runs a k3s homelab with ArgoCD, SOPS and an OpenTelemetry + LGTM
        stack, mostly built pairing with Claude Code.
      </p>
    </div>
  </DepthZone>

  <DepthZone id="reach" depth={60} band={3} title="Contact" contours="trench">
    <ul class="contact-links">
      {CONTACT.map((c) => (
        <li>
          <a href={c.href} rel={c.href.startsWith('mailto:') ? undefined : 'me'}>
            {c.label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </DepthZone>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    padding: 24px 0;
  }
  .side {
    display: grid;
    /* without an explicit track the column grows to the longest YAML line */
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    min-width: 0;
  }
  /* below this width the text column gets too narrow next to the card */
  @media (max-width: 1200px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .side {
      grid-template-columns: 280px minmax(0, 1fr);
      align-items: start;
      gap: 32px;
    }
  }
  @media (max-width: 860px) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }
    .side :global(.portrait) {
      max-width: 340px;
    }
  }
  .intro > * {
    min-width: 0;
  }
  h1 {
    margin: 14px 0 24px;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }
  .timeline,
  .talks {
    list-style: none;
    border-top: var(--hairline);
    max-width: 860px;
  }
  .timeline li,
  .talks li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: var(--hairline);
  }
  .timeline h3,
  .talks h3 {
    font-size: 1.2rem;
  }
  .timeline p,
  .talks p {
    color: var(--ink-soft);
    max-width: 64ch;
  }
  .talks h3 a {
    text-decoration: none;
  }
  .when {
    color: var(--accent-ink);
    font-size: 0.8rem;
    padding-top: 4px;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 48px;
    max-width: 960px;
  }
  .sub {
    font-size: 1.15rem;
    margin-bottom: 12px;
  }
  .plain {
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }
  .certs li {
    padding-left: 16px;
    position: relative;
  }
  .certs li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.6rem;
    top: 0.45em;
  }
  .contact-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .contact-links a {
    color: var(--accent-ink);
  }
  @media (max-width: 860px) {
    .intro,
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .timeline li,
    .talks li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
