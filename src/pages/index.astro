---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthZone from '../components/DepthZone.astro';
import LayeredDiagram from '../components/LayeredDiagram.astro';
import StarGrid from '../components/StarGrid.astro';
import ProjectRow from '../components/ProjectRow.astro';
import LatestPosts from '../components/LatestPosts.astro';
import Portrait from '../components/Portrait.astro';
import { getProjects } from '../lib/projects';
import { diagrams } from '../data/diagrams';
import { url } from '../lib/url';
import { CONTACT, SITE } from '../site';
import { certs, timeline } from '../data/career';
import { BOOKS } from '../data/books';

const projects = await getProjects();
const featured = projects.find((p) => p.data.featured);
const others = projects.filter((p) => p !== featured);
const featuredDiagram = featured?.data.diagram ? diagrams[featured.data.diagram] : undefined;

const layers = [
  {
    range: 'product',
    title: 'Start from the problem',
    text: 'I work with clients from discovery to production. Agreeing on what success looks like, and measuring it honestly, comes before picking a stack.',
  },
  {
    range: 'engineering',
    title: 'Bring engineering practices to every team',
    text: 'Agentic development, code review and system design, including for low-code developers and data scientists who never had them. AI makes the real bottlenecks obvious: quality, security and stability.',
  },
  {
    range: 'infrastructure',
    title: 'Pave the golden path',
    text: 'Self-service platforms on Kubernetes, Terraform and Azure, shipped through GitOps, with observability and cost guardrails built in from day one.',
  },
];
---

<BaseLayout>
  <DepthZone id="surface" depth={0} band={0} class="hero-zone">
    <div class="hero">
      <div>
        <p class="mono">
          {SITE.name} · {SITE.role}
        </p>
        <h1>
          I build the boring parts of shipping software,{' '}
          <em>so teams can spend their time on the fun ones.</em>
        </h1>
        <p class="lead">
          I'm a DevOps and Platform Engineer from Brazil. I use tools and practices like Kubernetes,
          GitOps, infrastructure as code and agentic development to make working on a development
          team a joy. I believe great products can only be built by teams that feel in control and
          are satisfied with their work, so I do my best to help them get there.
        </p>
      </div>
      <aside class="cartouche" aria-label="At a glance">
        <div class="glance">
          <Portrait class="glance-photo" sizes="(max-width: 860px) 90vw, 280px" loading="eager" />
          <p class="cartouche-title">At a glance</p>
          <dl>
            <div>
              <dt>Experience</dt>
              <dd>
                <ul class="roles">
                  {timeline.map((r) => (
                    <li>
                      <span>{r.where}</span>
                      <span class="mono yrs">{r.short}</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
            <div>
              <dt>Certified</dt>
              <dd>
                {certs.length} Microsoft certifications, including {certs[0]}
              </dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>Azure · AWS · Kubernetes · Terraform</dd>
            </div>
            <div>
              <dt>Based</dt>
              <dd>Brazil (UTC−3) · Remote</dd>
            </div>
          </dl>
          <a class="cartouche-more mono" href={url('/about/')}>
            Full background <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </DepthZone>

  <DepthZone
    id="work"
    depth={10}
    band={1}
    title="Selected work"
    contours="shoal"
    sightings={[{ fig: 'whale', x: 82, y: 1.5, size: 96 }]}
    soundings={[
      { x: 70, y: 18, v: '8' },
      { x: 82, y: 30, v: '11' },
      { x: 91, y: 12, v: '9' },
    ]}
  >
    {featured && (
      <article class="case">
        <aside class="case-meta">
          <strong>Case study</strong>
          <br />
          Year · {featured.data.year}
          {featured.data.company && (
            <>
              <br />
              At · {featured.data.company}
            </>
          )}
          <br />
          Role · {featured.data.role}
          {featured.data.team && (
            <>
              <br />
              Team · {featured.data.team}
            </>
          )}
          <br />
          Stack · {featured.data.stack.join(' · ').toLowerCase()}
        </aside>
        <div>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.summary}</p>
          {featuredDiagram && <LayeredDiagram id="fig-home" {...featuredDiagram} />}
          {featured.data.star && <StarGrid star={featured.data.star} />}
          <a class="read-more" href={url(`/projects/${featured.id}/`)}>
            Read the case study <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    )}
    {others.length > 0 && (
      <div class="list">
        {others.map((p) => (
          <ProjectRow project={p} />
        ))}
      </div>
    )}
  </DepthZone>

  <DepthZone
    id="how"
    depth={30}
    band={2}
    title="How I think about DevOps"
    contours="slope"
    sightings={[
      { fig: 'wheel', x: 72, y: 3, size: 60, rotate: 12 },
      { fig: 'telescope', x: 86, y: 5, size: 64, rotate: 6 },
    ]}
    soundings={[
      { x: 78, y: 4, v: '27' },
      { x: 88, y: 9, v: '31' },
    ]}
  >
    <div class="intro">
      <p>
        I like to think about problems end to end, from the first commit to the person using the
        product. What keeps me in this field is how quickly a change shows its effect: a pipeline
        gets faster, a deploy stops being scary, a team ships with less friction in the same week.
      </p>
      <p>
        End to end means keeping three layers in view, and making each one make sense to the people
        working on the others.
      </p>
    </div>
    <div class="profile">
      {layers.map((l) => (
        <div class="profile-row">
          <span class="mono range">{l.range}</span>
          <div>
            <h3>{l.title}</h3>
            <p>{l.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="shelf">
      <h3 class="shelf-title">Books that shaped how I think</h3>
      <ol class="books">
        {BOOKS.map((b) => (
          <li>
            <a href={b.url} class="book-title" target="_blank" rel="noopener">
              {b.title} <span aria-hidden="true">↗</span>
            </a>
            <span class="mono book-meta">
              {b.authors} · {b.year}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </DepthZone>

  <DepthZone
    id="contact"
    depth={60}
    band={3}
    title="Get in touch"
    contours="trench"
    sightings={[{ fig: 'squid', x: 82, y: 14, size: 80, rotate: -8 }]}
    soundings={[
      { x: 86, y: 44, v: '58' },
      { x: 92, y: 56, v: '63' },
    ]}
  >
    <div class="contact">
      <p>
        Ask me about golden paths, GitOps, OpenTelemetry, or why your next Kubernetes upgrade
        doesn't have to be scary. I also write about this stuff at Captain DevOps' Notes.
      </p>
      <ul class="contact-links">
        {CONTACT.map((c) => (
          <li>
            <a href={c.href} rel={c.href.startsWith('mailto:') ? undefined : 'me'}>
              {c.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
        <li>
          <a href={url('/about/')}>
            More about me <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="notes">
      <h3 class="notes-title">Latest from Captain DevOps' Notes</h3>
      <LatestPosts limit={3} />
    </div>
  </DepthZone>
</BaseLayout>

<style>
  /* the opening section fills the first screen, below the site header */
  @media (min-width: 861px) {
    :global(section.zone.hero-zone) {
      display: flex;
      align-items: center;
      min-height: calc(100svh - var(--header-h));
      padding-top: clamp(12px, 3svh, 40px);
      padding-bottom: clamp(12px, 3svh, 40px);
    }
    :global(.hero-zone > .zone-inner) {
      width: 100%;
    }
    :global(.hero-zone) .hero {
      padding: 0;
    }
  }
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
    padding: 24px 0;
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(2.1rem, 4.2vw, 3.3rem);
    line-height: 1.08;
  }
  h1 em {
    color: var(--accent);
  }
  .lead {
    margin-top: 22px;
    max-width: 44ch;
    font-size: 1.12rem;
    color: var(--ink-soft);
  }
  /* at-a-glance box */
  .cartouche {
    border: 1px solid var(--ink);
    outline: 0.5px solid var(--ink);
    outline-offset: 4px;
    padding: 22px 24px 16px;
    background: var(--paper);
    margin: 6px;
    min-width: 0;
    container-type: inline-size;
  }
  .cartouche :global(.glance-photo) {
    margin: -6px -8px 18px;
  }
  /* narrow box on desktop: a smaller photo keeps the hero within one screen */
  @media (min-width: 861px) {
    .cartouche :global(.glance-photo) {
      width: 60%;
      margin: 0 0 16px;
    }
  }
  /* wide box: photo on the left, facts on the right, so the hero fits one screen */
  @container (min-width: 380px) {
    .glance {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 20px;
      align-items: start;
    }
    .glance :global(.glance-photo) {
      grid-column: 1;
      grid-row: 1 / span 3;
      width: auto;
      margin: 0;
    }
    .glance > :not(:global(.glance-photo)) {
      grid-column: 2;
    }
    .cartouche .glance dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      padding: 5px 0;
    }
  }
  .cartouche-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 0.5px solid var(--line);
  }
  .cartouche dl > div {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    padding: 7px 0;
    font-size: 0.95rem;
  }
  .roles {
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 12px;
  }
  /* in a narrow box, put each label above its value instead of beside it */
  @container (max-width: 380px) {
    .cartouche dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
  .yrs {
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 3px;
  }
  .cartouche dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }
  .cartouche-more {
    display: block;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 0.5px solid var(--line);
    font-size: 0.78rem;
    color: var(--accent-ink);
  }

  .intro {
    max-width: var(--measure);
    font-size: 1.08rem;
    margin-bottom: 32px;
  }
  .intro p + p {
    margin-top: 0.8em;
  }
  .shelf {
    margin-top: 56px;
  }
  .shelf-title {
    font-size: 1.15rem;
    margin-bottom: 14px;
  }
  .books {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    border-top: var(--hairline);
    border-left: var(--hairline);
  }
  .books li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 14px 16px;
    border-right: var(--hairline);
    border-bottom: var(--hairline);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }
  .book-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.08rem;
    text-decoration: none;
  }
  .book-title span {
    font-size: 0.8em;
    color: var(--accent-ink);
  }
  .book-title:hover {
    color: var(--accent-ink);
  }
  .book-meta {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .profile {
    border-top: var(--hairline);
  }
  .profile-row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-bottom: var(--hairline);
  }
  .range {
    font-size: 0.8rem;
    color: var(--accent-ink);
    padding-top: 4px;
  }
  .profile-row h3 {
    font-size: 1.3rem;
  }
  .profile-row p {
    margin-top: 4px;
    max-width: 60ch;
    color: var(--ink-soft);
  }

  .case {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 44px;
  }
  .hero > *,
  .case > * {
    min-width: 0;
  }
  .case-meta {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.95;
    color: var(--muted);
    align-self: start;
  }
  .case-meta strong {
    color: var(--ink);
    font-weight: 500;
  }
  .case h3 {
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    line-height: 1.2;
    margin-bottom: 14px;
  }
  .case p {
    max-width: var(--measure);
  }
  .read-more {
    display: inline-block;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-ink);
  }
  .list {
    margin-top: 72px;
    border-top: var(--hairline);
  }

  .contact {
    max-width: var(--measure);
  }
  .notes {
    margin-top: 56px;
    max-width: 48rem;
  }
  .notes-title {
    font-size: 1.15rem;
    margin-bottom: 14px;
  }
  .contact p {
    font-size: 1.1rem;
  }
  .contact-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .contact-links a {
    color: var(--accent-ink);
  }

  @media (max-width: 860px) {
    .hero,
    .case {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .profile-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
